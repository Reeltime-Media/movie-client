# # GCP production API (direct from local dev — http is fine on localhost)
# NEXT_PUBLIC_API_URL=http://34.124.135.215:8000
# API_PROXY_TARGET=http://34.124.135.215:8000

#Local Development
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000

# Local Next.js origin (payment success redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_R2_PUBLIC_URL=

# Google OAuth Web client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID

# Optional: lets support/eng open DevTools in production via ?ddtk=<this value>
# despite the DevToolsGuard kill-switch. Leave unset to disable the bypass.
NEXT_PUBLIC_DEVTOOLS_BYPASS_SECRET==